generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String         // bcrypt hash
  programs      Program[]
  sessions      Session[]
  exercise      Exercise[]
  programDrafts ProgramDraft[]
  createdAt     DateTime       @default(now())
}

enum ProgramStatus {
  ACTIVE
  ARCHIVED
}

model Program {
  id            Int            @id @default(autoincrement())
  name          String         // e.g. "Styrka & Form"
  status        ProgramStatus  @default(ACTIVE)
  totalWeeks    Int            // e.g. 12
  daysPerWeek   Int            // e.g. 3 — how many workout days per week
  clonedFromId  Int?           // points to source program if this is a clone
  clonedFrom    Program?       @relation("ProgramClones", fields: [clonedFromId], references: [id])
  clones        Program[]      @relation("ProgramClones")
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  days          ProgramDay[]   // the workout templates — count should match daysPerWeek
  createdAt     DateTime       @default(now())
}

model ProgramDay {
  id         Int               @id @default(autoincrement())
  name       String            // e.g. "Workout 1"
  dayLabel   String?           // optional display label e.g. "Mån + Fre"
  duration   String?           // e.g. "ca 50 min"
  order      Int               @default(0) // determines cycle order: 0 = first in rotation
  programId  Int
  program    Program           @relation(fields: [programId], references: [id])
  sections   Section[]
  sessions   Session[]
}

model Section {
  id           Int               @id @default(autoincrement())
  name         String            // e.g. "Superset 1 · Uppvärmning"
  zone         String?           // e.g. "Zon 1 · TRX-stationen"
  sets         Int?              // target sets for the whole section
  restSecs     Int?
  order        Int               @default(0)
  programDayId Int
  programDay   ProgramDay        @relation(fields: [programDayId], references: [id])
  exercises    ProgramExercise[]
}

model ProgramExercise {
  id               Int               @id @default(autoincrement())
  exerciseId       Int
  exercise         Exercise          @relation(fields: [exerciseId], references: [id])
  targetSets       Int?              // e.g. 3
  targetReps       String?           // flexible: "6–8", "20s", "30m"
  targetWeight     Float?            // starting weight baseline
  notes            String?
  order            Int               @default(0)
  sectionId        Int
  section          Section           @relation(fields: [sectionId], references: [id])
  sessionExercises SessionExercise[]
}

enum ExerciseCategory {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
  CARDIO
  RECOVERY
}

enum TrackField {
  REPS
  WEIGHT
  DURATION
  DISTANCE
}

model Exercise {
  id               Int               @id @default(autoincrement())
  name             String            @unique // stored in swedish, no translation layer
  description      String?           // description of exercise like steps and tips
  link             String?           // link to instruction video, youtube etc
  category         ExerciseCategory  // English code; front end maps to swedish for display
  trackedFields    TrackField[]      // which SessionSet fields this exercise uses, e.g [DURATION, DISTANCE]
  userId           Int?              // null = global (admin-seed), set = user-private custom
  user             User?             @relation(fields: [userId], references: [id])
  programExercises ProgramExercise[] 
  createdAt        DateTime          @default(now())
}

model Session {
  id           Int               @id @default(autoincrement())
  date         DateTime          @default(now())
  weekNumber   Int               // derived server-side: which week of the program (1-based)
  dayNumber    Int               // derived server-side: which day within the week (1-based)
  completed    Boolean           @default(false) // false = in progress, true = finished
  notes        String?
  userId       Int
  user         User              @relation(fields: [userId], references: [id])
  programDayId Int               // which ProgramDay template was used
  programDay   ProgramDay        @relation(fields: [programDayId], references: [id])
  exercises    SessionExercise[]
  createdAt    DateTime          @default(now())
}

model SessionExercise {
  id                Int             @id @default(autoincrement())
  sessionId         Int
  session           Session         @relation(fields: [sessionId], references: [id])
  programExerciseId Int
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id])
  sets              SessionSet[]

  @@unique([sessionId, programExerciseId])
}

model SessionSet {
  id                Int             @id @default(autoincrement())
  setNumber         Int             // 1, 2, 3...
  reps              Int?            // actual reps performed
  weight            Float?          // kg
  duration          Int?            // seconds (for timed exercises)
  distance          Float?          // meters (for carries etc)
  completed         Boolean         @default(false) // ticked off during live workout
  notes             String?         // e.g. "felt heavy", "band-assisted"
  sessionExerciseId Int
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id])
}

model IntakeSubmission {
id                      Int             @id @default(autoincrement())
  firstName             String
  goal                  String
  experienceLevel       String
  age                   Int?
  weight                Int?
  height                Int?
  injuriesOrLimitations String?
  availableTime         String
  equipmentAccess       String?
  otherParallelTraining String?
  preferredExercises    String?
  programLengthWeeks    Int?
  programDraft          ProgramDraft?
  createdAt             DateTime        @default(now())
}

// The generated-but-not-yet-real program a client reviews before it becomes an actual
// `Program` row. `programData` is Program-shaped JSON validated against `ProgramSchema`
// (server/src/services/program.schema.ts) — the same schema `createProgramFromData`
// parses at confirm time, so this is never a second source of truth for that shape.
// One row per client for now (manual generation workflow) — no @@unique([userId]) yet
// since the real lifecycle (can a confirmed draft be replaced/regenerated later?) isn't
// decided, so the service just reads the most recent row instead of assuming exactly one.
model ProgramDraft {
  id                   Int              @id @default(autoincrement())
  userId               Int              // set at draft-creation time — the User already exists by then (created manually, same as today's program seeding)
  user                 User             @relation(fields: [userId], references: [id])
  intakeSubmissionId   Int              @unique
  intakeSubmission     IntakeSubmission @relation(fields: [intakeSubmissionId], references: [id])
  programData          Json             // Program-shaped JSON (see ProgramSchema) — the draft the client is reviewing
  editNotes            String?          // client's free-text "please change this" request, if any. Null = no open request.
  confirmed            Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}